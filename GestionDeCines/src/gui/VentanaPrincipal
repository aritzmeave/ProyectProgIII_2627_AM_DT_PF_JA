import java.awt.BorderLayout;
import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;

import javax.swing.JComponent;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JMenu;
import javax.swing.JMenuBar;
import javax.swing.JMenuItem;
import javax.swing.JOptionPane;
import javax.swing.JPanel;

import domain.DatosParaCines;
import domain.Pelicula;
import domain.Sesion;

public class VentanaPrincipal extends JFrame {

    private static final long serialVersionUID = 1L;

    private DatosParaCines datos;
    private JPanel panelCentral;
    private PanelCartelera panelCartelera;
    private JLabel lblResumen;
    private JLabel lblReloj;

    public VentanaPrincipal(DatosParaCines datos) {

        this.datos = datos;

        setTitle("Gestion de Cines");
        setSize(1000, 650);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        JMenuBar barraMenu = new JMenuBar();

        JMenu menuArchivo = new JMenu("Archivo");

        JMenuItem itemSalir = new JMenuItem("Salir");

        menuArchivo.add(itemSalir);

        JMenu menuPeliculas = new JMenu("Peliculas");

        JMenuItem itemNuevaPelicula =
                new JMenuItem("Nueva pelicula");

        JMenuItem itemEliminarPelicula =
                new JMenuItem("Eliminar pelicula");

        menuPeliculas.add(itemNuevaPelicula);
        menuPeliculas.add(itemEliminarPelicula);

        JMenu menuAyuda = new JMenu("Ayuda");

        JMenuItem itemAcercaDe = new JMenuItem("Acerca de");

        menuAyuda.add(itemAcercaDe);

        barraMenu.add(menuArchivo);
        barraMenu.add(menuPeliculas);
        barraMenu.add(menuAyuda);

        setJMenuBar(barraMenu);

        panelCentral = new JPanel(new BorderLayout());

        panelCartelera = new PanelCartelera(datos.getSesiones());

        panelCentral.add(panelCartelera, BorderLayout.CENTER);

        add(panelCentral, BorderLayout.CENTER);

        JPanel panelInferior = new JPanel(new BorderLayout());

        lblResumen = new JLabel();
        lblReloj = new JLabel();

        panelInferior.add(lblResumen, BorderLayout.WEST);
        panelInferior.add(lblReloj, BorderLayout.EAST);

        add(panelInferior, BorderLayout.SOUTH);

        itemSalir.addActionListener(e -> System.exit(0));

        itemNuevaPelicula.addActionListener(
                e -> nuevaPelicula());

        itemEliminarPelicula.addActionListener(
                e -> eliminarPeliculaSeleccionada());

        itemAcercaDe.addActionListener(e -> acercaDe());

        // Eliminar con la tecla Supr

        panelCartelera.getTabla().addKeyListener(new KeyAdapter() {

            @Override
            public void keyPressed(KeyEvent e) {

                if (e.getKeyCode() == KeyEvent.VK_DELETE) {
                    eliminarPeliculaSeleccionada();
                }
            }
        });

        actualizarResumen();

        HiloReloj hiloReloj = new HiloReloj(lblReloj);
        hiloReloj.start();
    }

    public void setCartelera(JComponent componente) {

        panelCentral.removeAll();

        panelCentral.add(componente, BorderLayout.CENTER);

        panelCentral.revalidate();
        panelCentral.repaint();
    }

    public void actualizarResumen() {

        lblResumen.setText(
                "Peliculas: " + datos.getPeliculas().size()
                + "  |  Sesiones: " + datos.getSesiones().size()
                + "  |  Salas: " + datos.getSalas().size());
    }

    public DatosParaCines getDatos() {
        return datos;
    }

    private void nuevaPelicula() {

        DialogoPelicula dialogo =
                new DialogoPelicula(this, datos);

        dialogo.setVisible(true);

        panelCartelera.actualizarTabla();

        actualizarResumen();
    }

    private void eliminarPeliculaSeleccionada() {

        Sesion sesion = panelCartelera.getSesionSeleccionada();

        if (sesion == null) {

            JOptionPane.showMessageDialog(
                    this,
                    "Selecciona una sesión");

            return;
        }

        Pelicula pelicula = sesion.getPelicula();

        int respuesta = JOptionPane.showConfirmDialog(
                this,
                "¿Eliminar '" + pelicula.getTitulo()
                        + "' y todas sus sesiones?",
                "Confirmar eliminación",
                JOptionPane.YES_NO_OPTION);

        if (respuesta == JOptionPane.YES_OPTION) {

            datos.getPeliculas().remove(pelicula);

            for (int i = datos.getSesiones().size() - 1;
                    i >= 0; i--) {

                if (datos.getSesiones().get(i).getPelicula()
                        == pelicula) {

                    datos.getSesiones().remove(i);
                }
            }

            panelCartelera.actualizarTabla();

            actualizarResumen();
        }
    }

    private void acercaDe() {

        JOptionPane.showMessageDialog(
                this,
                "Gestion de Cines\nProyecto de Programación III",
                "Acerca de",
                JOptionPane.INFORMATION_MESSAGE);
    }
}
